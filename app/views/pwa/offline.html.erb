<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sin conexión</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #ffffff;
      --fg: #000000;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #000000;
        --fg: #ffffff;
      }
    }

    html,
    body {
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      box-sizing: border-box;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
        Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: var(--bg);
      color: var(--fg);
    }

    button {
      font: inherit;
      color: var(--fg);
      background-color: var(--bg);
      border: 1px solid var(--fg);
      border-radius: 6px;
      padding: 0.5rem 1rem;
      cursor: pointer;
      margin-top: 1rem;
    }

    #orders-section {
      display: none;
      flex-direction: column;
      align-items: center;
      width: 100%;
      max-width: 600px;
    }

    #orders-section.visible {
      display: flex;
    }

    #orders {
      width: 100%;
    }

    .order {
      border: 1px solid var(--fg);
      border-radius: 6px;
      padding: 0.75rem;
      margin: 0.5rem 0;
      text-align: left;
      overflow-wrap: anywhere;
    }

    .order pre {
      white-space: pre-wrap;
      font: inherit;
      font-size: 0.875rem;
      margin: 0;
    }

    #last-updated {
      font-size: 0.875rem;
      opacity: 0.7;
    }
  </style>
</head>
<body>
  <h1>Sin conexión</h1>

  <section id="orders-section">
    <p id="orders-title"></p>
    <p id="last-updated"></p>
    <div id="orders"></div>
  </section>

  <button type="button" onclick="location.reload()">Reintentar</button>

  <script>
    (function () {
      const section = document.getElementById("orders-section");
      const title = document.getElementById("orders-title");
      const lastUpdated = document.getElementById("last-updated");
      const container = document.getElementById("orders");

      function render(cached, role) {
        const orders = role === "provider"
          ? cached.upcoming_orders
          : cached.orders;

        if (!Array.isArray(orders) || orders.length === 0) {
          return;
        }

        title.textContent = role === "provider"
          ? "Pedidos pendientes recibidos:"
          : "Pedidos realizados:";

        const savedAt = new Date(cached.saved_at);

        if (!isNaN(savedAt.getTime())) {
          lastUpdated.textContent =
            `Última actualización: ${savedAt.toLocaleString("es-UY")}`;
        }

        orders.forEach((order) => {
          const item = document.createElement("div");
          item.className = "order";

          const content = document.createElement("pre");
          content.textContent = JSON.stringify(order, null, 2);

          item.appendChild(content);
          container.appendChild(item);
        });

        section.classList.add("visible");
      }

      function loadOrders() {
        let currentUser = {role: "provider", id: 1};

        if (
          !currentUser ||
          !["consumer", "provider"].includes(currentUser.role) ||
          !Number.isFinite(Number(currentUser.id))
        ) {
          return;
        }

        const table = currentUser.role === "provider"
          ? "provider_orders"
          : "consumer_orders";

        const request = indexedDB.open("app-offline");

        request.onupgradeneeded = () => {
          // No crear una base vacía si todavía no existe.
          request.transaction.abort();
        };

        request.onerror = () => {};

        request.onsuccess = () => {
          const db = request.result;

          if (!db.objectStoreNames.contains(table)) {
            db.close();
            return;
          }

          try {
            const tx = db.transaction(table, "readonly");
            const query = tx.objectStore(table).get(
              Number(currentUser.id)
            );

            query.onsuccess = () => {
              if (query.result) {
                render(query.result, currentUser.role);
              }

              db.close();
            };

            query.onerror = () => db.close();
            tx.onabort = () => db.close();
          } catch {
            db.close();
          }
        };
      }

      loadOrders();
    })();
  </script>
</body>
</html>
