<% content_for :title, t(".title") %>

<p style="margin: 0 0 24px 0;"><%= t(".greeting", name: @user.name) %></p>

<p style="margin: 0 0 24px 0;"><%= t(".intro") %></p>

<p style="margin: 0 0 24px 0; font-family: Arial, Helvetica, sans-serif; font-size: 28px; line-height: 36px; font-weight: bold; color: #334155; text-align: left;">
  <%= @code %>
</p>

<p style="margin: 0 0 24px 0;"><%= t(".validity", minutes: @minutes) %> <%= t(".ignore") %></p>

<p style="margin: 0;"><%= @company&.name || "GoGrow" %></p>

