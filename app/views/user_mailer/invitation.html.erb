<%# Logo mark %>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
  <tr>
    <td align="center" style="padding-bottom:20px;">
      <img src="<%= attachments['serving-food.png'].url %>" width="41" height="41" alt="Viandas GoGrow" style="display:block;margin:0 auto;border:0;width:41px;height:41px;">
    </td>
  </tr>

  <%# Heading %>
  <tr>
    <td align="center" style="padding-bottom:12px;">
      <h1 style="margin:0;font-family:'Inter',Arial,sans-serif;font-size:24px;font-weight:700;color:#334155;line-height:1.2;">
        <%= t(".title") %>
      </h1>
    </td>
  </tr>

  <%# Body %>
  <tr>
    <td style="padding-bottom:8px;">
      <p style="margin:0;font-family:'Inter',Arial,sans-serif;font-size:14px;color:#334155;line-height:1.5;">
        <%= t(".greeting", name: @user.name) %>
      </p>
    </td>
  </tr>
  <tr>
    <td style="padding-bottom:24px;">
      <p style="margin:0;font-family:'Inter',Arial,sans-serif;font-size:14px;color:#334155;line-height:1.5;">
        <%= t(".intro", company: @company.name) %>
      </p>
    </td>
  </tr>

  <%# CTA button %>
  <tr>
    <td align="center" style="padding-bottom:24px;">
      <table role="presentation" cellspacing="0" cellpadding="0" border="0">
        <tr>
          <td style="background-color:#0F172A;border-radius:5px;">
            <%= link_to t(".cta"),
                        provider_welcome_url(token: @token, company: @company_token),
                        style: "display:inline-block;padding:7px 13px;font-family:'Inter',Arial,sans-serif;font-size:13px;font-weight:600;color:#FFFFFF;text-decoration:none;" %>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <%# After CTA %>
  <tr>
    <td style="padding-bottom:12px;">
      <p style="margin:0;font-family:'Inter',Arial,sans-serif;font-size:13px;color:#334155;line-height:1.5;">
        <%= t(".after", url: provider_sign_in_url) %>
      </p>
    </td>
  </tr>

  <%# Company name %>
  <tr>
    <td style="padding-bottom:28px;">
      <p style="margin:0;font-family:'Inter',Arial,sans-serif;font-size:13px;color:#334155;line-height:1.5;">
        <%= @company.name %>
      </p>
    </td>
  </tr>

  <%# GoGrow brand footer %>
  <tr>
    <td align="center">
      <img src="<%= attachments['gogrow-logo.png'].url %>" width="110" height="18" alt="GoGrow" style="display:inline-block;vertical-align:middle;border:0;height:18px;">
    </td>
  </tr>
</table>
