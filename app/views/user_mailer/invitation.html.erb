<% content_for :title, t(".title") %>

<p style="margin: 0 0 24px 0;"><%= t(".greeting", name: @user.name) %></p>

<p style="margin: 0 0 24px 0;"><%= t(".intro", company: @company.name) %></p>

<p style="margin: 0 0 24px 0; text-align: center;">
  <%= link_to t(".cta"), provider_welcome_url(token: @token, company: @company_token), style: "display: inline-block; padding: 8px 16px; background-color: #0f172a; border-radius: 6px; font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 24px; color: #ffffff; text-decoration: none;" %>
</p>

<p style="margin: 0 0 24px 0;"><%= t(".after", url: provider_sign_in_url) %></p>

<p style="margin: 0;"><%= @company.name %></p>
