# Copy to .env and fill in. Loaded by dotenv-rails in development and test.

# FRONTEND

VITE_APP_NAME="Rails Inertia Base"
VITE_SENTRY_DSN=dsn

# BACKEND

RAILS_SENTRY_DSN=dsn

# Mission Control (job dashboard basic auth)
MISSION_CONTROL_JOBS_HTTP_BASIC_AUTH_USER=admin
MISSION_CONTROL_JOBS_HTTP_BASIC_AUTH_PASSWORD=change-me

# Google Sign-In (provider login) — from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
