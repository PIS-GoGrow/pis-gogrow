# Copy to .env and fill in. Loaded by dotenv-rails in development and test.

# FRONTEND

VITE_APP_NAME="Rails Inertia Base"
VITE_SENTRY_DSN=dsn

# BACKEND

COMPANY_ACCOUNT_VAT_ENABLED=false

RAILS_SENTRY_DSN=dsn

# Resúmenes del beneficio con Claude. Configurar ambos valores solo en el backend.
# Sin ellos, la generación devuelve un error de configuración y no hace solicitudes externas.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Mission Control (job dashboard basic auth)
MISSION_CONTROL_JOBS_HTTP_BASIC_AUTH_USER=admin
MISSION_CONTROL_JOBS_HTTP_BASIC_AUTH_PASSWORD=change-me

# Google Sign-In (provider login) — from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login de prueba sin Google (ver docs/guia-trabajo-repositorio.md).
# Contraseña de las cuentas que crea db/seeds.rb: mínimo 12 caracteres, nunca
# se commitea, y sin ella el seed no corre. Pedile el valor a quien administra
# el entorno.
DEV_USERS_PASSWORD=
# En "true" la pantalla de ingreso muestra el formulario de correo y contraseña
# además del botón de Google. Dejar en "false" fuera de los entornos de prueba.
DEV_LOGIN_ENABLED=false

# Envío de correo. En desarrollo, sin SMTP_HOST los correos se guardan en tmp/letter_opener;
# con SMTP_HOST definido se mandan de verdad (por ejemplo con Gmail y una contraseña de aplicación).
# APP_HOST es el dominio que llevan los enlaces de los correos en producción, sin protocolo.
APP_HOST=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Token con el que Motor Admin invita proveedores (POST /internal/provider_invitations,
# header "Authorization: Bearer <token>"). Sin valor, el endpoint responde 404.
MOTOR_ADMIN_API_TOKEN=

# Variables de configuración de Twilio (para notificaciones de WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DELIVERY_ENABLED=false # Activar a true para que se envíen notificaciones
TWILIO_PHONE="whatsapp:+14155238886"
